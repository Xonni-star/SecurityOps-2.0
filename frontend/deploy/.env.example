# ==============================================================================
# SecurityOps 2.0 - Production Environment (.env)
# Copy to deploy/.env, set permissions 600, never commit real values.
# ==============================================================================

# 1. Public hostname (Caddy TLS certificate)
DOMAIN=securityops.example
# Optional: host ports for the Caddy proxy (default 80/443)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# 2. PostgreSQL 16
POSTGRES_DB=securityops_v2
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGEME_POSTGRES_ADMIN_PASSWORD
# Password for the least-privilege application role (secops_app_user).
# Generate with: openssl rand -hex 24
POSTGRES_APP_PASSWORD=CHANGEME_APP_USER_PASSWORD

# 3. JWT / Sessions
# Generate with: openssl rand -hex 32 (minimum 32 characters)
JWT_SECRET=CHANGEME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# 4. CORS whitelist (must match the public frontend origin exactly)
CORS_ORIGIN=https://securityops.example

# Internal Docker network used by the backend and Caddy.
# If this overlaps a host/VPN route, choose another subnet and keep the proxy IP inside it.
SECOPS_INTERNAL_SUBNET=172.30.0.0/24
SECOPS_PROXY_IPV4=172.30.0.2
# Must be the exact Caddy address above, not the whole internal subnet.
TRUST_PROXY=172.30.0.2/32
RATE_LIMIT_MAX=120
# Production Compose uses its private Redis service at redis://redis:6379.
# Multi-instance deployments must point every backend at the same protected Redis service.

# 5. Encrypted database backups
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=CHANGEME_BACKUP_ENCRYPTION_KEY

# 6. DMS private S3-compatible storage and mandatory malware scan
# Generate dedicated, least-privilege S3 credentials in the selected provider.
DMS_S3_ENDPOINT=https://s3.example.invalid
DMS_S3_REGION=eu-central-1
DMS_S3_BUCKET=securityops-documents
DMS_S3_ACCESS_KEY=CHANGEME_S3_ACCESS_KEY
DMS_S3_SECRET_KEY=CHANGEME_S3_SECRET_KEY
DMS_S3_FORCE_PATH_STYLE=false
DMS_SCAN_REQUIRED=true
DMS_SCANNER_PROVIDER=clamav
DMS_CLAMAV_HOST=clamav.example.internal
DMS_CLAMAV_PORT=3310
DMS_CLAMAV_TIMEOUT_MS=30000
# DMS upload limit (10 MiB default; the backend caps this at 100 MiB)
DMS_MAX_FILE_SIZE_BYTES=10485760
