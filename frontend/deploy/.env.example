# ==============================================================================
# SecurityOps 2.0 - Production Environment (.env)
# Copy to deploy/.env, set permissions 600, never commit real values.
# ==============================================================================

# 1. Public hostname (Caddy TLS certificate)
DOMAIN=securityops.example
# Optional: host ports for the Caddy proxy (default 80/443)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# 2. PostgreSQL 16
POSTGRES_DB=securityops_v2
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGEME_POSTGRES_ADMIN_PASSWORD
# Password for the least-privilege application role (secops_app_user).
# Generate with: openssl rand -hex 24
POSTGRES_APP_PASSWORD=CHANGEME_APP_USER_PASSWORD

# 3. JWT / Sessions
# Generate with: openssl rand -hex 32 (minimum 32 characters)
JWT_SECRET=CHANGEME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# 4. CORS whitelist (must match the public frontend origin exactly)
CORS_ORIGIN=https://securityops.example

# 5. Encrypted database backups
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=CHANGEME_BACKUP_ENCRYPTION_KEY

# DMS upload limit (10 MiB default; the backend caps this at 100 MiB)
DMS_MAX_FILE_SIZE_BYTES=10485760
