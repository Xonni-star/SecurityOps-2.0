# ==============================================================================
# SECURITYOPS 2.0 - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# Mandatory for Docker Compose, database migrations, and cryptographic secrets
# ==============================================================================

# 1. Host & Domain
ENV=production
DEBUG=false
DOMAIN=securityops.de

# 2. Database (PostgreSQL 16+)
POSTGRES_DB=securityops_v2
POSTGRES_USER=secops_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME_SECURE_POSTGRES_PW_2025

# 3. Redis Message Broker
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGEME_SECURE_REDIS_PW_2025

# 4. Cryptographic Authentication & JWT Secret (HS256)
# Generate with: openssl rand -hex 64
SECRET_KEY=CHANGEME_HEX64_SECRET_KEY_FOR_JWT_AUTHENTICATION

# 5. Backup Encryption
# Symmetric key for gpg/openssl AES-256 backup archives
BACKUP_ENCRYPTION_KEY=CHANGEME_AES256_BACKUP_VAULT_KEY

# 6. Storage & Uploads
STORAGE_ROOT=/var/lib/securityops/storage
MAX_FILE_UPLOAD_BYTES=15728640
