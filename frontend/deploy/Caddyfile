# SecurityOps 2.0 - Production Reverse Proxy & TLS (Caddy)
# API requests are forwarded to the TypeScript/Express backend.
# The frontend is served from the static production build in /srv.

{
    admin off
}

{$DOMAIN:localhost} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CSP entspricht den tatsächlich genutzten Ressourcen:
        # - Tailwind CDN + Inline-Konfiguration im Frontend
        # - API-Aufrufe bleiben auf denselben Host beschränkt
        # - data:/blob: für Bildvorschauen
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
        -Server
    }

    request_body {
        max_size 15MB
    }

    # SecurityOps TypeScript/Express API
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # React Single-Page-Application (Vite production build)
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
