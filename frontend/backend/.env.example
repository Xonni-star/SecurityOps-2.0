# ==============================================================================
# SECURITYOPS 2.0 - BACKEND UMGEBUNGSVARIABLEN (.env.example)
# Kopieren nach 'backend/.env' und kryptografisch sichere Werte eintragen!
# WICHTIG: Niemals echte Passwörter oder JWT-Keys ins Git-Repository einchecken!
# ==============================================================================

# Server & Umgebung (development | test | production)
PORT=8000
NODE_ENV=development

# 1. Anwendungsdatenbankverbindung (STRENG UNPRIVILEGIERT: secops_app_user)
# Darf NIEMALS Superuser oder BYPASSRLS-Rechte besitzen!
# Format: postgresql://secops_app_user:[PASSWORD]@127.0.0.1:5432/securityops_v2
DATABASE_URL=postgresql://secops_app_user:HIER_SICHERES_APP_PASSWORT_EINTRAGEN@127.0.0.1:5432/securityops_v2

# 2. Migrationsdatenbankverbindung (ADMINISTRATIV: secops_admin)
# Ausschließlich für DDL-Migrationen und Schema-Upgrades (wird vom Migration-Runner verwendet)
# Format: postgresql://secops_admin:[PASSWORD]@127.0.0.1:5432/securityops_v2
DATABASE_MIGRATION_URL=postgresql://secops_admin:HIER_SICHERES_ADMIN_PASSWORT_EINTRAGEN@127.0.0.1:5432/securityops_v2

# Privater, persistenter DMS-Dateispeicher (nicht aus dem Frontend-Verzeichnis ausliefern)
# Standard: backend/var/documents; Produktion: eigenes Volume, siehe deploy/docker-compose.production.yml
DMS_STORAGE_PATH=./var/documents
# Uploadlimit pro Datei (Standard 10 MiB, maximal 100 MiB)
DMS_MAX_FILE_SIZE_BYTES=10485760

# Kryptografisches JWT-Geheimnis (Mindestens 32 Zeichen - Pflicht)
# Erzeugen mit: openssl rand -hex 32
JWT_SECRET=HIER_MINDESTENS_32_ZEICHEN_LANGES_KRYPTOGRAFISCHES_GEHEIMNIS_EINTRAGEN

# JWT & Session Gültigkeitsdauer (z. B. '8h', '1h', '30m')
JWT_EXPIRES_IN=8h

# CORS Whitelist (Sicherheit: Streng kommagetrennte Liste, KEIN Wildcard '*'!)
# Nur explizite HTTP/HTTPS-Origins sind zulässig:
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Trusted reverse proxy IPs/CIDRs (comma-separated); leave empty when directly exposed.
# Trust only proxies that overwrite X-Forwarded-For before reaching this backend.
TRUST_PROXY=

# Rate Limiting (Maximale Anfragen pro Minute je IP)
RATE_LIMIT_MAX=120
# Optional lokal; im Produktivmodus erforderlich und von allen Backend-Instanzen gemeinsam zu verwenden.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
