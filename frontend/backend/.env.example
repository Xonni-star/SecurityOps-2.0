# ==============================================================================
# SECURITYOPS 2.0 - BACKEND UMGEBUNGSVARIABLEN (.env.example)
# Kopieren nach 'backend/.env' und kryptografisch sichere Werte eintragen!
# WICHTIG: Niemals echte Passwörter oder JWT-Keys ins Git-Repository einchecken!
# ==============================================================================

# Server & Umgebung (development | test | production)
PORT=8000
NODE_ENV=development

# PostgreSQL 16+ Verbindungszeichenfolge
# HINWEIS: Für RLS-Sicherheit den unprivilegierten Anwendungsbenutzer verwenden!
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://secops_app_user:HIER_SICHERES_PASSWORT_EINTRAGEN@127.0.0.1:5432/securityops_v2

# Kryptografisches JWT-Geheimnis (Mindestens 32 Zeichen - Pflicht)
# Erzeugen mit: openssl rand -hex 32
JWT_SECRET=HIER_MINDESTENS_32_ZEICHEN_LANGES_KRYPTOGRAFISCHES_GEHEIMNIS_EINTRAGEN

# JWT Gültigkeitsdauer (z. B. 8h für eine operative Dienstschicht)
JWT_EXPIRES_IN=8h

# CORS Whitelist (im Produktivbetrieb spezifische FQDN angeben, z. B. https://leitstelle.securityops.de)
CORS_ORIGIN=*

# Rate Limiting (Maximale Anfragen pro Minute je IP)
RATE_LIMIT_MAX=120
