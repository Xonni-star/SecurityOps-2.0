# ==============================================================================
# SECURITYOPS 2.0 - BACKEND UMGEBUNGSVARIABLEN (.env.example)
# Kopieren nach 'backend/.env' und echte, sichere Werte eintragen!
# ==============================================================================

# Server & Umgebung
PORT=8000
NODE_ENV=development

# PostgreSQL 16+ Verbindungszeichenfolge
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://secops_admin:HierSicheresPasswortSetzen_2025@localhost:5432/securityops_v2

# Kryptografisches JWT-Geheimnis (Mindestens 32 Zeichen erforderlich)
# Erzeugen mit: openssl rand -hex 32
JWT_SECRET=HIER_EIGENES_MINDESTENS_32_ZEICHEN_LANGES_JWT_GEHEIMNIS_EINTRAGEN

# JWT Gültigkeitsdauer (z.B. 8h für eine operative Dienstschicht)
JWT_EXPIRES_IN=8h

# CORS Whitelist (im Produktivbetrieb spezifische Domain angeben)
CORS_ORIGIN=*

# Rate Limiting (Maximale Anfragen pro Minute)
RATE_LIMIT_MAX=120
