{
  "name": "securityops-backend",
  "version": "2.0.0",
  "description": "SecurityOps 2.0 - Enterprise Node.js/TypeScript REST API mit PostgreSQL 16+ RLS und Multi-Tenancy",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "migrate": "ts-node src/migrations/runner.ts",
    "seed": "ts-node src/seeds/seed.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:clamav-integration": "ts-node src/integration/clamavAdapter.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "argon2": "^0.40.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "argon2@0.40.3": true
  }
}
