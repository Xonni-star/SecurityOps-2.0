{
  "appId": "de.securityops.mobile",
  "appName": "SecurityOps 2.0",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0f1d",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0f1d"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}